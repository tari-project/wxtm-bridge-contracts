{
  "name": "@tari-project/wxtm-bridge-contracts",
  "version": "0.3.0",
  "description": "Utility pack for wxtm-bridge-contracts",
  "keywords": [
    "wxtmbridge",
    "smartcontracts"
  ],
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/tari-project/wxtm-bridge-contracts.git",
    "directory": "wxtm-bridge-contracts-typechain"
  },
  "main": "index.js",
  "gypfile": false,
  "files": [
    "index.js",
    "index.d.ts",
    "deployments/*.js",
    "deployments/*.d.ts",
    "deployments/deployments.json",
    "typechain/**/*.js",
    "typechain/**/*.d.ts",
    "utils/*.js",
    "utils/*.d.ts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prebuild": "npm run copy",
    "build": "npx tsc",
    "copy": "../scripts/copy.sh"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
