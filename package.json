{
    "name": "@tari-project/wxtm-bridge-contracts",
    "version": "0.6.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "clean": "rm -rf artifacts cache out",
        "compile": "concurrently -c auto --names forge,hardhat '$npm_execpath run compile:forge' '$npm_execpath run compile:hardhat'",
        "compile:forge": "forge build",
        "compile:hardhat": "hardhat compile",
        "export-deployments-base-sepolia": "npx hardhat --network base-sepolia-testnet run scripts/build/export-deployments.ts",
        "export-deployments-mainnet": "npx hardhat --network mainnet run scripts/build/export-deployments.ts",
        "export-deployments-sepolia": "npx hardhat --network sepolia-testnet run scripts/build/export-deployments.ts",
        "gas:lzCompose": "forge script scripts/solidity/GasProfiler.s.sol:GasProfilerScript --via-ir --sig 'run_lzCompose(string,address,uint32,address,uint32,address,address,bytes[],uint256,uint256)'",
        "gas:lzReceive": "forge script scripts/solidity/GasProfiler.s.sol:GasProfilerScript --via-ir --sig 'run_lzReceive(string,address,uint32,address,uint32,address,bytes[],uint256,uint256)'",
        "gas:run": "forge script scripts/solidity/OFTProfilerExample.s.sol:OFTProfilerExample --via-ir --sig 'run(uint256)'",
        "lint": "$npm_execpath run lint:js && $npm_execpath run lint:sol",
        "lint:fix": "eslint --fix '**/*.{js,ts,json}' && prettier --write . && solhint 'contracts/**/*.sol' --fix --noPrompt",
        "lint:js": "eslint '**/*.{js,ts,json}' && prettier --check .",
        "lint:sol": "solhint 'contracts/**/*.sol'",
        "test": "$npm_execpath run test:forge && $npm_execpath run test:hardhat",
        "test:forge": "forge test",
        "test:hardhat": "hardhat test"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.3",
        "@eslint/js": "^9.39.2",
        "@layerzerolabs/devtools-evm-hardhat": "^4.0.4",
        "@layerzerolabs/lz-definitions": "^3.0.152",
        "@layerzerolabs/lz-evm-messagelib-v2": "^3.0.152",
        "@layerzerolabs/lz-evm-sdk-v2": "^3.0.152",
        "@layerzerolabs/lz-evm-v1-0.7": "^3.0.152",
        "@layerzerolabs/lz-v2-utilities": "^3.0.152",
        "@layerzerolabs/metadata-tools": "^3.0.2",
        "@layerzerolabs/oapp-evm": "^0.4.1",
        "@layerzerolabs/oapp-evm-upgradeable": "^0.1.3",
        "@layerzerolabs/oft-evm": "^4.0.1",
        "@layerzerolabs/oft-evm-upgradeable": "^4.0.2",
        "@layerzerolabs/toolbox-foundry": "^0.1.13",
        "@layerzerolabs/toolbox-hardhat": "^0.6.13",
        "@openzeppelin/contracts": "^5.4.0",
        "@openzeppelin/contracts-upgradeable": "^5.4.0",
        "@rocketh/deploy": "^0.17.6",
        "@rocketh/node": "^0.17.9",
        "@rocketh/read-execute": "^0.17.5",
        "@rumblefishdev/hardhat-kms-signer": "^2.0.0",
        "@rushstack/eslint-patch": "^1.7.0",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.6",
        "@types/node": "^25.0.3",
        "chai": "^6.2.2",
        "concurrently": "^9.2.1",
        "dotenv": "^17.2.3",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jest-extended": "^3.0.1",
        "eslint-plugin-prettier": "^5.5.4",
        "ethers": "^6.16.0",
        "hardhat": "^3.1.2",
        "hardhat-contract-sizer": "^2.10.1",
        "hardhat-deploy": "2.0.0-next.57",
        "hardhat-typechain": "^0.3.5",
        "install": "^0.13.0",
        "mocha": "^11.7.5",
        "npm": "^11.7.0",
        "prettier": "^3.2.5",
        "rocketh": "^0.17.9",
        "solhint": "^6.0.2",
        "solidity-bytes-utils": "^0.8.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "pnpm": {
        "overrides": {
            "form-data": "^4.0.4",
            "@openzeppelin/contracts": "^5.4.0",
            "@openzeppelin/contracts-upgradeable": "^5.4.0",
            "ws": "^5.2.4",
            "axios": "^0.30.2",
            "qs": "^6.14.1"
        }
    },
    "overrides": {
        "form-data": "^4.0.4",
        "@openzeppelin/contracts": "^5.4.0",
        "@openzeppelin/contracts-upgradeable": "^5.4.0",
        "ws": "^5.2.4",
        "axios": "^0.30.2",
        "qs": "^6.14.1"
    }
}
